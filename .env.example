# Canonical site URL used by metadata, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.minutestodecimal.org

# Google Analytics 4 measurement ID — paste your real ID after creating a GA4 property.
# Format: G-XXXXXXXXXX
# Leave empty/unset to keep analytics disabled.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# AdSense publisher ID — paste your real ID after AdSense approves the site.
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave empty/unset to keep the site ad-free (recommended until approval).
NEXT_PUBLIC_ADSENSE_CLIENT=
