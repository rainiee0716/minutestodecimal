# Canonical site URL used by metadata, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.minutestodecimal.org

# Google Analytics 4 measurement ID — paste your real ID after creating a GA4 property.
# Format: G-XXXXXXXXXX
# Leave empty/unset to keep analytics disabled.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# AdSense publisher ID — paste your real ID after AdSense approves the site.
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave empty/unset to keep the site ad-free (recommended until approval).
NEXT_PUBLIC_ADSENSE_CLIENT=

# DEV.to API key for scripts/publish-devto.mjs.
# Create it in DEV.to → Settings → Extensions → DEV Community API Keys.
DEVTO_API_KEY=

# Hashnode GraphQL token for scripts/publish-hashnode.mjs.
# Create a Personal Access Token in Hashnode → Settings → Developer.
HASHNODE_TOKEN=

# Hashnode publication ID. You can also pass --host or --publication-id.
HASHNODE_PUBLICATION_ID=

# Optional. Hashnode may change or restrict its GraphQL endpoint for some plans.
# Override this only if Hashnode gives you a different endpoint.
HASHNODE_GRAPHQL_ENDPOINT=https://gql.hashnode.com

# Medium Integration Token for scripts/publish-medium.mjs.
# Create it in Medium → Settings → Security and apps → Integration tokens.
MEDIUM_TOKEN=

# Optional. Your Medium user ID. If omitted, the script calls /v1/me to resolve it.
MEDIUM_USER_ID=
